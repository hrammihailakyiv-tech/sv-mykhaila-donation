# Frontend (публічні значення; безпечні для браузера). Скопіюйте у .env.local
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Секрети платіжного провайдера НЕ кладуться у .env фронтенду.
# Вони задаються лише через Supabase Secrets (див. README):
#   supabase secrets set LIQPAY_PUBLIC_KEY=... LIQPAY_PRIVATE_KEY=...
#   SITE_URL=https://your-domain.example
#   PAYMENT_HOST_ALLOWLIST=www.liqpay.ua,liqpay.ua
#   PAYMENT_MODE=live   (або demo)
